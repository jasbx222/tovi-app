rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /environments/{environment}/meetings/{sessionId}/messages/{messageId} {
      allow read, write: if request.auth != null
        && request.auth.token.toviEnvironment == environment
        && request.auth.token.sessionId == sessionId
        && request.resource.data.environment == environment;
    }
  }
}
